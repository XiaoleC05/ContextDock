{
  // markdownlint-cli2 自身的配置。
  //
  // 规则开关仍然放在 .markdownlint.json —— 那是标准位置，
  // 编辑器和其它工具也认它，不要让规则配置跟着本文件搬家。
  //
  // 这里只声明一件事：**哪些 .md 不该被当成文档来检查**。
  "ignores": [
    // 评测语料是**数据**，不是文档。它的作用是「被切分、被检索」。
    //
    // 对它套用文档规范是范畴错误，而且有两个具体危害：
    //
    //  1. 外部语料不能改。rust-book-*.md 来自上游（MIT OR Apache-2.0），
    //     许可要求逐字保留，改动要在 ATTRIBUTION 里逐条声明。
    //     为了让 lint 通过去改别人的原文，代价和收益不成比例。
    //
    //  2. 语料一改，评测数字就作废。corpus.json 钉的是内容 sha256，
    //     任何改动都让历史结果不可比，必须重跑基线。
    //     为了空格和 <span> 标签付这个代价，不值。
    //
    // 需要 lint 的是项目自己的文档：README.md、docs/*.md。
    "eval/corpus/**"
  ]
}
