# ---- 二进制与构建产物 ----
/bin/
/dist/
# ⚠️ 必须锚定到仓库根（开头的 /）。
#
# 曾经这里写的是裸的 `contextdock`，本意是忽略编译产物，
# 但裸模式会匹配**任意层级**下同名文件或目录——包括 cmd/contextdock/。
# 结果整个程序入口从没被提交，而本地因为文件就在磁盘上一切正常，
# 直到 CI 报 "directory not found" 才发现。
#
# 教训：.gitignore 里忽略具体名字时，尽量写锚定路径。
/contextdock
*.exe
*.exe~
*.dll
*.so
*.dylib

# ---- Go 测试与性能分析产物 ----
*.test
*.out
coverage.out
coverage.html
cpu.prof
mem.prof
*.pprof

# ---- 依赖目录 ----
# 应用类项目通常提交 vendor/，如需离线构建再取消注释
# /vendor/

# ---- 密钥与环境变量（重要：硅基流动 API Key 绝不能提交）----
.env
.env.*
!.env.example

# ---- 本地数据与临时目录 ----
/data/
/tmp/
*.log

# ---- 临时文件（工具/代理可能产生，不入库）----
/.tmp_research/
/.tmp/

# ---- IDE ----
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
*.swp

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
